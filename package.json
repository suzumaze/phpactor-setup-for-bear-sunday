{
    "name": "phpactor-setup-for-bear-sunday",
    "displayName": "Phpactor Setup for BEAR.Sunday",
    "description": "Phpactor公式VS Code拡張を前提に、BEAR.Sunday向けPhpactorとbear-phpactor-extensionのグローバルセットアップを行う拡張",
    "version": "0.2.4",
    "private": true,
    "publisher": "suzumaze",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/suzumaze/phpactor-setup-for-bear-sunday.git"
    },
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:phpactorSetup.setup",
        "onCommand:phpactorSetup.update",
        "onCommand:phpactorSetup.showCoreVersion",
        "onCommand:phpactorSetup.restore",
        "workspaceContains:composer.json"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "phpactorSetup.setup",
                "title": "Phpactor Setup for BEAR.Sunday: グローバルセットアップ"
            },
            {
                "command": "phpactorSetup.update",
                "title": "Phpactor Setup for BEAR.Sunday: コアを更新"
            },
            {
                "command": "phpactorSetup.showCoreVersion",
                "title": "Phpactor Setup for BEAR.Sunday: 使用中のコアバージョンを確認"
            },
            {
                "command": "phpactorSetup.restore",
                "title": "Phpactor Setup for BEAR.Sunday: クリーンアンインストール"
            }
        ]
    },
    "extensionPack": [
        "phpactor.vscode-phpactor"
    ],
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node --test test/*.test.js",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "1.91.0",
        "@vscode/vsce": "^3.0.0",
        "typescript": "^5.4.0"
    }
}
