{
    "name": "phpactor-setup-for-bear-sunday",
    "displayName": "Phpactor Setup for BEAR.Sunday",
    "description": "BEAR.Sunday プロジェクト向けに phpactor と、BEAR.Sunday の規約を phpactor に教える Composer パッケージ（suzumaze/bear-phpactor-extension）のグローバルインストールを代行するセットアップ専用拡張",
    "version": "0.1.0",
    "publisher": "suzumaze",
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:phpactorSetup.setup",
        "workspaceContains:composer.json"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "phpactorSetup.setup",
                "title": "Phpactor Setup for BEAR.Sunday: このプロジェクト向けにセットアップ"
            }
        ],
        "configuration": {
            "title": "Phpactor Setup for BEAR.Sunday",
            "properties": {
                "phpactorSetup.sourceRepo": {
                    "type": "string",
                    "default": "/Users/suzumaze/MyProject/BEAR.Lsp",
                    "description": "suzumaze/bear-phpactor-extension のソースリポジトリ。composer の path リポジトリとして参照する絶対パス。"
                },
                "phpactor.path": {
                    "type": "string",
                    "description": "phpactor バイナリの絶対パス。この拡張がグローバルインストール先の vendor/bin/phpactor を書き込む。"
                }
            }
        }
    },
    "extensionPack": [
        "phpactor.vscode-phpactor"
    ],
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "@vscode/vsce": "^3.0.0",
        "typescript": "^5.4.0"
    }
}
